{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compass-camp-watcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALERT_EMAIL": "hello@compassbyvavy.ca",
    "ALERT_FROM": "hello@compassbyvavy.ca"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["hello@compassbyvavy.ca"]
    }
  ],
  "triggers": {
    "crons": ["20 5 * * *", "0 11 * * *", "0 12 * * *"]
  }
}
