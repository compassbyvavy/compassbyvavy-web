{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compassbyvavy-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Explicit review flags. Production traffic still cannot load samples:
  // each *ReviewPreviewEnabled helper also requires a Cloudflare Preview URL host.
  "vars": {
    "COMPASS_CAMPS_REVIEW_PREVIEW": "true",
    "COMPASS_PLAY_REVIEW_PREVIEW": "true",
    "COMPASS_DISCOVER_REVIEW_PREVIEW": "true"
  }
}
