{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compassbyvavy-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Play and Discover sample catalogs still require their review flags plus a
  // preview host. Camp pages do not: a preview host reads staging Supabase
  // (STAGING_SUPABASE_URL and STAGING_SUPABASE_ANON_KEY), and production reads
  // SUPABASE_URL and SUPABASE_ANON_KEY. Neither host loads camp fixtures.
  "vars": {
    "COMPASS_CAMPS_REVIEW_PREVIEW": "true",
    "COMPASS_PLAY_REVIEW_PREVIEW": "true",
    "COMPASS_DISCOVER_REVIEW_PREVIEW": "true"
  }
}
